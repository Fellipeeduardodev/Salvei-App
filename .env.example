# ==============================================================================
# CURATOR — VARIÁVEIS DE AMBIENTE (SUPABASE & PERSISTÊNCIA REAL)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para `.env.local`:
#    cp .env.example .env.local
# 2. Preencha as variáveis abaixo com a URL e a Publishable Key do seu projeto Supabase.
#    (Disponíveis no painel do Supabase em Project Settings > API).
# 3. NUNCA adicione chaves secretas (como service_role) no frontend.
# ==============================================================================

# URL do projeto Supabase (ex: https://seu-projeto.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon/publishable (segura para o navegador com Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo_chave_publica_aqui

# Nome do bucket de mídia privado no Supabase Storage
VITE_SUPABASE_STORAGE_BUCKET=curator-media
