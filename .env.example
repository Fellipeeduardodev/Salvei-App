# ==============================================================================
# SALVEI — VARIÁVEIS DE AMBIENTE (NEON POSTGRESQL & SERVIÇOS)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para `.env.local`:
#    cp .env.example .env.local
# 2. Preencha com a URL de conexão do Neon PostgreSQL (Projeto: salvei / sa-east-1)
# ==============================================================================

# Conexão Neon PostgreSQL (Pooler recomendado para serverless)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-exemplo.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=main

# Chave de API do Google Gemini (IA para OCR e Visão Computacional)
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui
